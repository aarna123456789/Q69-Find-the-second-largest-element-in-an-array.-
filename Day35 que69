#include<stdio.h>
int main()
{
int a[100],i,n,j,temp;
printf("enter size of array");
scanf("%d",&n);
printf("enter array element");
for(i=0;i<n;i++)
scanf("%d",&a[i]);
for(i=0;i<n;i++)
{
  for(j=i+1;j<n;j++)
  {
    if(a[i]<a[j])
    {
      temp=a[i];
      a[i]=a[j];
      a[j]=temp;
    }
  }
}
printf("second largest element %d",a[1]);
return 0;
}
